{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/src/**",
      "**/messages/**",
      "**/tests/**",
      "**/scripts/**/*.ts",
      "**/next.config.ts",
      "**/biome.config.js",
      "./vitest.*.ts",
      "./vitest.*.mts"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "warn",
        "useHookAtTopLevel": "error"
      },
      "a11y": {
        "useButtonType": "off",
        "noSvgWithoutTitle": "off",
        "useKeyWithClickEvents": "off"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "useImportType": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error"
      },
      "complexity": {
        "noForEach": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "performance": {
        "noImgElement": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**", "!src/core/components/main/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/link": "Use Link from @/i18n/navigation (CONVENTIONS.md, i18n).",
                  "next/navigation": {
                    "allowImportNames": ["useSearchParams", "useParams"],
                    "message": "Use @/i18n/navigation; only useSearchParams and useParams come from next/navigation (CONVENTIONS.md, i18n)."
                  }
                },
                "patterns": [
                  {
                    "group": ["@/modules/**", "@/app/**"],
                    "message": "core never imports modules or app; only the app shell in core/components/main may (ARCHITECTURAL_SPINE.md, dependency rule 1)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/core/components/main/**",
        "src/modules/*/components/**",
        "src/modules/*/hooks/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/link": "Use Link from @/i18n/navigation (CONVENTIONS.md, i18n).",
                  "next/navigation": {
                    "allowImportNames": ["useSearchParams", "useParams"],
                    "message": "Use @/i18n/navigation; only useSearchParams and useParams come from next/navigation (CONVENTIONS.md, i18n)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/modules/*/controller.ts",
        "src/modules/*/service.ts",
        "src/modules/*/middleware.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next/headers": "Controllers and services also serve the mobile app: no Next request context (ARCHITECTURAL_SPINE.md, dependency rule 4).",
                  "next/cache": "Controllers and services also serve the mobile app: no Next request context (ARCHITECTURAL_SPINE.md, dependency rule 4).",
                  "next/navigation": "Controllers and services also serve the mobile app: no Next request context (ARCHITECTURAL_SPINE.md, dependency rule 4).",
                  "next-intl/server": "The API is locale-agnostic and answers with keys (CONVENTIONS.md, i18n)."
                }
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  }
}
